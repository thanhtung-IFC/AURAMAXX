# Sao chép tệp này thành .env ở thư mục gốc khi cần cấu hình riêng.
# Không điền khóa thật vào tệp mẫu hoặc frontend.
# AURA AI: chọn openai hoặc gemini. API key chỉ được đọc ở backend.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-6-astra
# Với Gemini, đặt AI_PROVIDER=gemini và AI_MODEL=gemini-3.8-flash.
# Có thể dùng GEMINI_API_KEY thay AI_API_KEY để dùng lại cấu hình chatbot cũ.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=1200
# Gemini's budget includes internal thinking. Visible answers stay concise and bounded.
AI_GEMINI_MAX_OUTPUT_TOKENS=8192
AI_RATE_LIMIT_PER_MINUTE=8
AURAMAXX_DB_BACKEND=postgres
FACE_DB_BACKEND=postgres
# One Supabase Session pooler connection (port 5432, sslmode=require) for both stores.
DATABASE_URL=
AURAMAXX_POSTGRES_SCHEMA=public
FACE_POSTGRES_SCHEMA=visionface
AUTH_COOKIE_SECURE=false
AURAMAXX_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
